{
  "name": "shawtie-pls-app",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.18.0"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "eslint \"apps/**/*.{ts,tsx}\" \"packages/**/*.{ts,tsx}\" --max-warnings=0",
    "format": "prettier --write \"apps/**/*.{ts,tsx,html,json}\" \"packages/**/*.{ts,tsx,json}\" \"*.{json,mjs}\"",
    "format:check": "prettier --check \"apps/**/*.{ts,tsx,html,json}\" \"packages/**/*.{ts,tsx,json}\" \"*.{json,mjs}\"",
    "deps:check": "node scripts/ci/check-dependencies.mjs",
    "test": "npm run test:domain && npm run test:contracts && npm run test:worker",
    "test:domain": "node --test packages/domain/tests/*.test.ts",
    "test:contracts": "node --test packages/contracts/tests/*.test.ts",
    "test:worker": "node --test apps/worker/tests/*.test.ts",
    "test:f2:postgres": "npm run db:test:invariants && npm run build --workspace @shawtie/db && npm run build --workspace @shawtie/testkit && npm run build --workspace @shawtie/worker && node --test packages/testkit/tests/*.integration.test.ts apps/worker/tests/*.integration.test.ts",
    "health:repo": "node scripts/ci/repository-health.mjs",
    "health": "npm run health:repo && npm run db:migrations:check && npm run typecheck && npm run build && npm run lint && npm run format:check && npm run deps:check && npm test",
    "ci:baseline": "npm run health",
    "db:migrations:check": "node scripts/db/check-migrations.mjs",
    "db:migrate": "node scripts/db/migrate.mjs",
    "db:test:invariants": "node scripts/db/test-invariants.mjs"
  },
  "devDependencies": {
    "@types/node": "22.20.3",
    "eslint": "10.11.0",
    "prettier": "3.9.8",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.0"
  }
}
