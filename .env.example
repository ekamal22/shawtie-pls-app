# Shawtie pls environment example
# Copy values into your process environment or deployment secret store.
# Never commit real credentials.

NODE_ENV=development
DATABASE_URL=postgresql://shawtie:shawtie@127.0.0.1:5432/shawtie
APP_ORIGIN=http://127.0.0.1:5173

# API and worker must share the same authentication key ring.
AUTH_HMAC_KEYS=1:<base64-encoded-32-byte-or-longer-secret>
AUTH_HMAC_ACTIVE_VERSION=1

# Transactional authentication email.
# Keep disabled for local development unless you intentionally want real sends.
EMAIL_PROVIDER=disabled
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=Shawtie pls
BREVO_TIMEOUT_MS=10000
