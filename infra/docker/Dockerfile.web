FROM node:22.18.0-bookworm-slim@sha256:752ea8a2f758c34002a0461bd9f1cee4f9a3c36d48494586f60ffce1fc708e0e
ENV NODE_ENV=production
WORKDIR /app/apps/web
COPY apps/web/dist ./dist
COPY apps/web/server.mjs ./server.mjs
COPY apps/web/server-security.mjs ./server-security.mjs
COPY apps/web/proxy-security.mjs ./proxy-security.mjs
EXPOSE 4173
HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 CMD ["node","-e","fetch('http://127.0.0.1:'+(process.env.PORT||'4173')+'/health',{headers:{host:new URL(process.env.APP_ORIGIN).host}}).then(r=>{if(!r.ok)process.exit(1)}).catch(()=>process.exit(1))"]
CMD ["node","server.mjs"]
