# R2 production environment contract.
# Values shown in angle brackets are placeholders. Store real secrets in the provider secret store.
# Run: R2_SERVICE_ROLE=<api|worker|web> node scripts/release/verify-production-contract.mjs

NODE_ENV=production
APP_ORIGIN=https://<public-app-origin>

# API and worker
DATABASE_URL=postgresql://<user>:<password>@<private-postgres-host>:5432/<database>?sslmode=require
AUTH_HMAC_KEYS=1:<base64-32-byte-or-longer-secret>
AUTH_HMAC_ACTIVE_VERSION=1

# API product mode
PARTNER_REQUEST_MODE=paired
MEDIA_UPLOAD_INITIATION_ENABLED=1
MEDIA_BINDING_ENABLED=1
MEDIA_DOWNLOAD_GRANT_ENABLED=1
C1_CALLING_ENABLED=1
C1_TRANSPORT_ENABLED=1
C2_VIDEO_ENABLED=1
C1_TURN_URLS=turns:<turn-host>:5349?transport=tcp
C1_TURN_SHARED_SECRET=<turn-shared-secret>
C1_PUSH_VAPID_PUBLIC_KEY=<vapid-public-key>

# API and worker private S3-compatible encrypted object storage
MEDIA_S3_ENDPOINT=https://<private-object-storage-origin>
MEDIA_S3_BUCKET=<bucket>
MEDIA_S3_REGION=<region>
MEDIA_S3_ACCESS_KEY_ID=<access-key-id>
MEDIA_S3_SECRET_ACCESS_KEY=<secret-access-key>

# Worker email and push delivery
EMAIL_PROVIDER=brevo
BREVO_API_KEY=<brevo-api-key>
BREVO_SENDER_EMAIL=<verified-sender-address>
BREVO_SENDER_NAME=Shawtie pls
BREVO_TIMEOUT_MS=10000
C1_PUSH_VAPID_SUBJECT=mailto:<operator-contact>
C1_PUSH_VAPID_PRIVATE_KEY=<vapid-private-key>

# Optional worker tuning
WORKER_BATCH_SIZE=20
WORKER_CONCURRENCY=4
WORKER_POLL_INTERVAL_MS=1000
WORKER_LEASE_MS=60000
WORKER_SHUTDOWN_GRACE_MS=30000

# Web adapter
BACKEND_PROXY_TARGET=https://<private-api-origin>
WEB_TRUSTED_PROXY=<exact-ingress-ip-or-cidr>
WEB_MEDIA_CONNECT_SRC=https://<object-storage-download-origin>
# Only set this to 1 for an explicitly reviewed private internal HTTP hostname.
WEB_ALLOW_PRIVATE_BACKEND_HTTP=0

# Build-time web release identity, not a long-lived secret.
SHAWTIE_RELEASE_ID=<exact-release-source-sha>
